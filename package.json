{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:bdd": "cucumber-js --config cucumber.js",
    "test:smoke": "cucumber-js --config cucumber.js --profile default --profile smoke",
    "test:playwright": "playwright test",
    "cucumberRegression": "npx cucumber-js --tags \"@Regression\" --retry 1 --exit --format html:cucumber-report.html",
    "cucumberSmoke": "npx cucumber-js --tags \"@Smoke\" --retry 1 --exit --format html:cucumber-report.html",
    "cucumberSanity": "npx cucumber-js --tags \"@Sanity\" --retry 1 --exit --format html:cucumber-report.html"
  },
